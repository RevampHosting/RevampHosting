# ---------------------------------------------------------------------------
# Copy to .env.local (local dev) or add in your hosting provider's dashboard.
# NEVER commit real values. Only variables prefixed NEXT_PUBLIC_ reach the browser.
# ---------------------------------------------------------------------------

# Public URL of the website (used for SEO, sitemap and links in emails)
NEXT_PUBLIC_SITE_URL=https://www.yourcompany.com

# Supabase — Project Settings → API. The service-role key is SERVER-ONLY.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Resend — https://resend.com/api-keys
RESEND_API_KEY=
# Sender address on a domain you verified in Resend
EMAIL_FROM="Northline Website <quotes@yourcompany.com>"

# Where quote requests are emailed (change any time to re-route)
QUOTE_NOTIFICATION_EMAIL=owner@yourcompany.com
# Optional — defaults to QUOTE_NOTIFICATION_EMAIL
CONTACT_NOTIFICATION_EMAIL=
REVIEW_NOTIFICATION_EMAIL=

# Admin access: comma-separated emails allowed into /admin.
# Each must also exist as a user in Supabase → Authentication → Users.
ADMIN_EMAILS=owner@yourcompany.com
# Random string, at least 32 characters (e.g. `openssl rand -base64 48`)
SESSION_SECRET=

# Optional: Cloudflare Turnstile CAPTCHA for extra spam protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
